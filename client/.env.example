# Copy to .env. Vite only exposes VITE_*-prefixed vars to the browser.

# API base. Using a relative /api lets the Vite dev proxy forward to :5000
# without cross-origin cookie pain. Override in prod to your deployed API URL.
VITE_API_URL=/api

# Stripe publishable key — safe to ship to the browser. Server holds the secret.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
