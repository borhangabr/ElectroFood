# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database ---
# MongoDB Atlas connection string (replace with your cluster URI)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/foodordering?retryWrites=true&w=majority&appName=ElectroFood

# --- Auth (use openssl rand -hex 32 or node -e "console.log(crypto.randomBytes(32).toString('hex'))") ---
JWT_ACCESS_SECRET=replace_with_a_long_random_32plus_char_string_xxxxxxxxxxxx
JWT_REFRESH_SECRET=replace_with_a_different_long_random_32plus_char_string_xx
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=7d

# --- Stripe ---
STRIPE_SECRET=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me_after_running_stripe_listen
STRIPE_CURRENCY=usd
DELIVERY_FEE_CENTS=300

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# --- SendGrid Email (optional - will add later) ---
# SENDGRID_API_KEY=replace_me
# SENDGRID_FROM_EMAIL=noreply@example.com
